{
  "format_on_save": "on",
  "prettier": {
    "allowed": false
  },
  "formatter": {
    "language_server": {
      "name": "oxfmt"
    }
  },
  "code_actions_on_format": {
    "source.fixAll.eslint": false,
    "source.fixAll.oxc": true
  },
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": "oxlint.config.ts"
        }
      }
    }
  }
}
